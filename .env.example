# Copy to .env and adjust for your machine.
#   cp .env.example .env
#
# Never commit .env. Placeholders only — replace before any shared or staging use.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=realledger
POSTGRES_PASSWORD=realledger_dev_only
POSTGRES_DB=realledger
# Host port 5433 avoids clashing with other local Postgres containers on 5432.
POSTGRES_PORT=5433

# App connection string (Day 3+). Same credentials and port as above.
DATABASE_URL=postgres://realledger:realledger_dev_only@localhost:5433/realledger?sslmode=disable

# --- API process (Day 3+) ---
HTTP_ADDR=:8080
LOG_LEVEL=info
# SHUTDOWN_TIMEOUT_SEC=10

# --- Auth (Day 11+) — separate keys for tenant app vs platform admin ---
# Generate with: openssl rand -base64 48
JWT_TENANT_SECRET=change-me-tenant-dev-only-not-for-production
JWT_PLATFORM_SECRET=change-me-platform-dev-only-not-for-production
